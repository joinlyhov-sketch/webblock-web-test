# Required on Vercel. Use the pooled, TLS-enabled PostgreSQL URL from your provider.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: separate independent demo datasets when sharing a database.
WEBBLOCK_DATA_NAMESPACE=webblock-demo-v1

# Optional local development file. Vercel always requires the database above.
# WEBBLOCK_STATE_FILE=.data/webblock-state.json
